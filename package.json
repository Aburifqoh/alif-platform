{
  "name": "alif-monorepo",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.6.0",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/**\" dev",
    "build": "pnpm --recursive build",
    "lint": "pnpm --recursive lint",
    "start": "pnpm --parallel --filter \"./apps/**\" start",
    "deploy:web": "pnpm --filter @alif/web run deploy",
    "deploy:admin": "pnpm --filter @alif/admin run deploy"
  },
  "devDependencies": {
    "turbo": "^2.1.0"
  }
}
