unded-xl transition-all\" href=\"/events\"><div class=\"w-9 h-9 rounded-lg bg-gradient-to-br from-blue-600 to-blue-700 flex items-center justify-center shrink-0\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-calendar w-4 h-4 text-white\" aria-hidden=\"true\"><path d=\"M8 2v3\"></path><path d=\"M16 2v3\"></path><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\"></rect><path d=\"M3 9h18\"></path></svg></div><span class=\"text-white/80 text-sm font-medium group-hover:text-white transition-colors\">Events</span></a><a class=\"group flex items-center gap-3 p-3.5 bg-white/8 hover:bg-white/15 border border-white/10 rounded-xl transition-all\" href=\"/donate\"><div class=\"w-9 h-9 rounded-lg bg-gradient-to-br from-rose-600 to-rose-700 flex items-center justify-center shrink-0\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-heart w-4 h-4 text-white\" aria-hidden=\"true\"><path d=\"M2 9.5a5.5 5.5 0 0 1 9.591-3.676.56.56 0 0 0 .818 0A5.49 5.49 0 0 1 22 9.5c0 2.29-1.5 4-3 5.5l-5.492 5.313a2 2 0 0 1-3 .019L5 15c-1.5-1.5-3-3.2-3-5.5\"></path></svg></div><span class=\"text-white/80 text-sm font-medium group-hover:text-white transition-colors\">Donate</span></a><a class=\"group flex items-center gap-3 p-3.5 bg-white/8 hover:bg-white/15 border border-white/10 rounded-xl transition-all\" href=\"/hostel\"><div class=\"w-9 h-9 rounded-lg bg-gradient-to-br from-purple-600 to-purple-700 flex items-center justify-center shrink-0\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-house w-4 h-4 text-white\" aria-hidden=\"true\"><path d=\"M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8\"></path><path d=\"M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"></path></svg></div><span class=\"text-white/80 text-sm font-medium group-hover:text-white transition-colors\">Hostel</span></a><a class=\"group flex items-center gap-3 p-3.5 bg-white/8 hover:bg-white/15 border border-white/10 rounded-xl transition-all\" href=\"/register\"><div class=\"w-9 h-9 rounded-lg bg-gradient-to-br from-teal-600 to-teal-700 flex items-center justify-center shrink-0\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-users w-4 h-4 text-white\" aria-hidden=\"true\"><path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"></path><path d=\"M16 3.128a4 4 0 0 1 0 7.744\"></path><path d=\"M22 21v-2a4 4 0 0 0-3-3.87\"></path><circle cx=\"9\" cy=\"7\" r=\"4\"></circle></svg></div><span class=\"text-white/80 text-sm font-medium group-hover:text-white transition-colors\">Members</span></a></div></div></div></div><div class=\"absolute bottom-0 left-0 right-0\"><svg viewBox=\"0 0 1440 80\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M0 80L1440 80L1440 30C1320 60 1200 70 1080 55C960 40 840 10 720 20C600 30 480 60 360 65C240 70 120 50 0 30L0 80Z\" fill=\"white\" class=\"dark:fill-[#0d1117]\"></path></svg></div></section><section id=\"mission\" class=\"py-24 bg-white dark:bg-[#0d1117]\"><div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\"><div class=\"text-center mb-16\"><span class=\"text-brand-red dark:text-brand-red-light text-sm font-semibold uppercase tracking-widest\">Our Purpose</span><h2 class=\"mt-3 text-4xl sm:text-5xl font-bold text-gray-900 dark:text-white font-[Outfit]\">Mission &amp; Vision</h2></div><div class=\"grid md:grid-cols-2 gap-8\"><div class=\"group p-8 rounded-3xl border border-gray-100 dark:border-white/10 bg-gradient-to-br from-[#f0fdf4] to-white dark:from-emerald-950/30 dark:to-[#161b22] hover:shadow-xl transition-all\"><div class=\"w-12 h-12 rounded-2xl bg-gradient-to-br from-brand-red to-brand-red-dark flex items-center justify-center mb-6\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-globe w-6 h-6 text-white\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20\"></path><path d=\"M2 12h20\"></path></svg></div><h3 class=\"text-2xl font-bold text-gray-900 dark:text-white font-[Outfit] mb-4\">Our Mission</h3><p class=\"text-gray-600 dark:text-gray-400 leading-relaxed\">To propagate authentic Islam based on the Qur&#x27;an and authentic Sunnah, upon the understanding of the Salaf — through education, Da&#x27;wah, community development, and youth mentorship — serving Muslims across Nigeria and beyond.</p></div><div class=\"group p-8 rounded-3xl border border-gray-100 dark:border-white/10 bg-gradient-to-br from-[#fef9e7] to-white dark:from-yellow-950/20 dark:to-[#161b22] hover:shadow-xl transition-all\"><div class=\"w-12 h-12 rounded-2xl bg-gradient-to-br from-[#b8860b] to-[#d4a017] flex items-center justify-center mb-6\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-star w-6 h-6 text-white\" aria-hidden=\"true\"><path d=\"M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z\"></path></svg></div><h3 class=\"text-2xl font-bold text-gray-900 dark:text-white font-[Outfit] mb-4\">Our Vision</h3><p class=\"text-gray-600 dark:text-gray-400 leading-relaxed\">To be the leading Islamic foundation in Nigeria — a model institution that transforms individuals, families, and communities through authentic Islamic knowledge, character development, and organized welfare services.</p></div></div></div></section><section class=\"py-24 bg-[#faf6ef] dark:bg-[#161b22]\"><div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid lg:grid-cols-2 gap-16 items-center\"><div><span class=\"text-brand-red dark:text-brand-red-light text-sm font-semibold uppercase tracking-widest\">About ALIF</span><h2 class=\"mt-3 text-4xl sm:text-5xl font-bold text-gray-900 dark:text-white font-[Outfit] leading-tight\">Al-Ibaanah Islamic Foundation</h2><div class=\"mt-6 space-y-4 text-gray-600 dark:text-gray-400 leading-relaxed\"><p>Al-Ibaanah Islamic Foundation (ALIF) is an Islamic organization committed to upholding and disseminating authentic Islamic knowledge based on the Qur&#x27;an, the authentic Sunnah, and the understanding of the Salaf us-Salih.</p><p>Since our founding, we have grown into a comprehensive institution offering Islamic education from Qur&#x27;an and Tajweed to Arabic language and advanced Islamic sciences. Our hostel facilities provide a nurturing environment for students committed to full-time learning.</p><p>Our Da&#x27;wah efforts extend from public lectures and seminars to community outreach programs, welfare services, and youth mentorship — serving thousands of Muslims across Nigeria.</p></div><div class=\"mt-8 flex flex-wrap gap-4\"><a class=\"inline-flex items-center gap-2 px-6 py-3 bg-brand-red text-white font-semibold rounded-full hover:bg-[#166534] transition-colors font-[Outfit]\" href=\"/about\">Learn More <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-right w-4 h-4\" aria-hidden=\"true\"><path d=\"m9 18 6-6-6-6\"></path></svg></a></div></div><div class=\"grid grid-cols-2 gap-4\"><div class=\"p-5 bg-white dark:bg-[#21262d] rounded-2xl border border-gray-100 dark:border-white/8 hover:shadow-md transition-all group\"><div class=\"w-10 h-10 rounded-xl mb-3 flex items-center justify-center bg-brand-red-tint dark:bg-brand-red-dark/50 text-brand-red dark:text-brand-red-light\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-book-open w-5 h-5\" aria-hidden=\"true\"><path d=\"M12 5v16\"></path><path d=\"M20.001 19A2 2 0 0022 17V5a2 2 0 00-1.999-2L16 3.002A5 5 0 0012 5a5 5 0 00-4-2H4a2 2 0 00-2 2v12a2 2 0 001.999 2H8a5 5 0 014 2 5 5 0 014-2z\"></path></svg></div><h4 class=\"text-sm font-bold text-gray-900 dark:text-white font-[Outfit] mb-1\">Islamic Education</h4><p class=\"text-xs text-gray-500 dark:text-gray-400 leading-relaxed\">Qur&#x27;an, Tajweed, Arabic, Aqeedah, Fiqh, Hadith &amp; more</p></div><div class=\"p-5 bg-white dark:bg-[#21262d] rounded-2xl border border-gray-100 dark:border-white/8 hover:shadow-md transition-all group\"><div class=\"w-10 h-10 rounded-xl mb-3 flex items-center justify-center bg-yellow-100 dark:bg-yellow-950/50 text-[#b8860b] dark:text-yellow-400\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-mosque w-5 h-5\" aria-hidden=\"true\"><path d=\"M12.268 2a2 2 0 003.465 2\"></path><path d=\"M14 5 L14 8\"></path><path d=\"M16 22v-3a2 2 0 00-4 0v3\"></path><path d=\"M21 13c-.662-1.497-1.666-2.753-2.9-3.63C16.825 8.47 15.422 8 14 8s-2.826.47-4.1 1.37C8.668 10.248 7.663 11.504 7 13z\"></path><path d=\"M3 9h4\"></path><path d=\"M7 22V6a5 5 0 00-2-4 5 5 0 00-2 4v14a2 2 0 002 2h14a2 2 0 002-2v-7\"></path></svg></div><h4 class=\"text-sm font-bold text-gray-900 dark:text-white font-[Outfit] mb-1\">Mosque Activities</h4><p class=\"text-xs text-gray-500 dark:text-gray-400 leading-relaxed\">Daily prayers, Friday Khutbah, Ramadan programs &amp; Eid</p></div><div class=\"p-5 bg-white dark:bg-[#21262d] rounded-2xl border border-gray-100 dark:border-white/8 hover:shadow-md transition-all group\"><div class=\"w-10 h-10 rounded-xl mb-3 flex items-center justify-center bg-purple-100 dark:bg-purple-950/50 text-purple-600 dark:text-purple-400\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-house w-5 h-5\" aria-hidden=\"true\"><path d=\"M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8\"></path><path d=\"M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"></path></svg></div><h4 class=\"text-sm font-bold text-gray-900 dark:text-white font-[Outfit] mb-1\">Hostel Management</h4><p class=\"text-xs text-gray-500 dark:text-gray-400 leading-relaxed\">Safe, structured accommodation for full-time students</p></div><div class=\"p-5 bg-white dark:bg-[#21262d] rounded-2xl border border-gray-100 dark:border-white/8 hover:shadow-md transition-all group\"><div class=\"w-10 h-10 rounded-xl mb-3 flex items-center justify-center bg-rose-100 dark:bg-rose-950/50 text-rose-600 dark:text-rose-400\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-heart w-5 h-5\" aria-hidden=\"true\"><path d=\"M2 9.5a5.5 5.5 0 0 1 9.591-3.676.56.56 0 0 0 .818 0A5.49 5.49 0 0 1 22 9.5c0 2.29-1.5 4-3 5.5l-5.492 5.313a2 2 0 0 1-3 .019L5 15c-1.5-1.5-3-3.2-3-5.5\"></path></svg></div><h4 class=\"text-sm font-bold text-gray-900 dark:text-white font-[Outfit] mb-1\">Welfare &amp; Outreach</h4><p class=\"text-xs text-gray-500 dark:text-gray-400 leading-relaxed\">Emergency aid, scholarships, and community projects</p></div><div class=\"p-5 bg-white dark:bg-[#21262d] rounded-2xl border border-gray-100 dark:border-white/8 hover:shadow-md transition-all group\"><div class=\"w-10 h-10 rounded-xl mb-3 flex items-center justify-center bg-blue-100 dark:bg-blue-950/50 text-blue-600 dark:text-blue-400\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-users w-5 h-5\" aria-hidden=\"true\"><path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"></path><path d=\"M16 3.128a4 4 0 0 1 0 7.744\"></path><path d=\"M22 21v-2a4 4 0 0 0-3-3.87\"></path><circle cx=\"9\" cy=\"7\" r=\"4\"></circle></svg></div><h4 class=\"text-sm font-bold text-gray-900 dark:text-white font-[Outfit] mb-1\">Community Building</h4><p class=\"text-xs text-gray-500 dark:text-gray-400 leading-relaxed\">Membership, committees, and leadership development</p></div><div class=\"p-5 bg-white dark:bg-[#21262d] rounded-2xl border border-gray-100 dark:border-white/8 hover:shadow-md transition-all group\"><div class=\"w-10 h-10 rounded-xl mb-3 flex items-center justify-center bg-teal-100 dark:bg-teal-950/50 text-teal-600 dark:text-teal-400\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-globe w-5 h-5\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20\"></path><path d=\"M2 12h20\"></path></svg></div><h4 class=\"text-sm font-bold text-gray-900 dark:text-white font-[Outfit] mb-1\">Da&#x27;wah &amp; Media</h4><p class=\"text-xs text-gray-500 dark:text-gray-400 leading-relaxed\">Lectures, publications, media center &amp; online content</p></div></div></div></section><section class=\"py-24 bg-[#faf6ef] dark:bg-[#161b22]\"><div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\"><div class=\"text-center mb-16\"><span class=\"text-brand-red dark:text-brand-red-light text-sm font-semibold uppercase tracking-widest\">What We Offer</span><h2 class=\"mt-3 text-4xl sm:text-5xl font-bold text-gray-900 dark:text-white font-[Outfit]\">Our Programs</h2><p class=\"mt-4 text-gray-600 dark:text-gray-400 max-w-2xl mx-auto\">Comprehensive Islamic programs designed to nurture knowledge, character, and community.</p></div><div class=\"grid sm:grid-cols-2 lg:grid-cols-4 gap-5\"><a class=\"group p-6 bg-white dark:bg-[#21262d] rounded-2xl border border-gray-100 dark:border-white/8 hover:shadow-xl hover:-translate-y-1.5 transition-all\" href=\"/programs/education\"><div class=\"w-12 h-12 rounded-xl bg-gradient-to-br from-brand-red to-brand-red-dark flex items-center justify-center mb-4 group-hover:scale-110 transition-transform\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-book-open w-6 h-6 text-white\" aria-hidden=\"true\"><path d=\"M12 5v16\"></path><path d=\"M20.001 19A2 2 0 0022 17V5a2 2 0 00-1.999-2L16 3.002A5 5 0 0012 5a5 5 0 00-4-2H4a2 2 0 00-2 2v12a2 2 0 001.999 2H8a5 5 0 014 2 5 5 0 014-2z\"></path></svg></div><h3 class=\"text-base font-bold text-gray-900 dark:text-white font-[Outfit] mb-2\">Islamic Education</h3><p class=\"text-sm text-gray-500 dark:text-gray-400\">Aqeedah · Fiqh · Hadith · Tafseer · Seerah</p><div class=\"mt-4 flex items-center gap-1 text-brand-red dark:text-brand-red-light text-sm font-semibold opacity-0 group-hover:opacity-100 transition-opacity\">Explore <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-right w-4 h-4\" aria-hidden=\"true\"><path d=\"m9 18 6-6-6-6\"></path></svg></div></a><a class=\"group p-6 bg-white dark:bg-[#21262d] rounded-2xl border border-gray-100 dark:border-white/8 hover:shadow-xl hover:-translate-y-1.5 transition-all\" href=\"/programs/quran\"><div class=\"w-12 h-12 rounded-xl bg-gradient-to-br from-teal-600 to-teal-700 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-volume2 lucide-volume-2 w-6 h-6 text-white\" aria-hidden=\"true\"><path d=\"M11 4.702a.705.705 0 0 0-1.203-.498L6.413 7.587A1.4 1.4 0 0 1 5.416 8H3a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2.416a1.4 1.4 0 0 1 .997.413l3.383 3.384A.705.705 0 0 0 11 19.298z\"></path><path d=\"M16 9a5 5 0 0 1 0 6\"></path><path d=\"M19.364 18.364a9 9 0 0 0 0-12.728\"></path></svg></div><h3 class=\"text-base font-bold text-gray-900 dark:text-white font-[Outfit] mb-2\">Qur&#x27;an &amp; Tajweed</h3><p class=\"text-sm text-gray-500 dark:text-gray-400\">Recitation · Memorisation · Hifdh · Tajweed rules</p><div class=\"mt-4 flex items-center gap-1 text-brand-red dark:text-brand-red-light text-sm font-semibold opacity-0 group-hover:opacity-100 transition-opacity\">Explore <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-right w-4 h-4\" aria-hidden=\"true\"><path d=\"m9 18 6-6-6-6\"></path></svg></div></a><a class=\"group p-6 bg-white dark:bg-[#21262d] rounded-2xl border border-gray-100 dark:border-white/8 hover:shadow-xl hover:-translate-y-1.5 transition-all\" href=\"/programs/arabic\"><div class=\"w-12 h-12 rounded-xl bg-gradient-to-br from-blue-600 to-blue-700 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-globe w-6 h-6 text-white\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20\"></path><path d=\"M2 12h20\"></path></svg></div><h3 class=\"text-base font-bold text-gray-900 dark:text-white font-[Outfit] mb-2\">Arabic Language</h3><p class=\"text-sm text-gray-500 dark:text-gray-400\">Vocabulary · Grammar · Speaking · Writing</p><div class=\"mt-4 flex items-center gap-1 text-brand-red dark:text-brand-red-light text-sm font-semibold opacity-0 group-hover:opacity-100 transition-opacity\">Explore <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-right w-4 h-4\" aria-hidden=\"true\"><path d=\"m9 18 6-6-6-6\"></path></svg></div></a><a class=\"group p-6 bg-white dark:bg-[#21262d] rounded-2xl border border-gray-100 dark:border-white/8 hover:shadow-xl hover:-translate-y-1.5 transition-all\" href=\"/programs/youth\"><div class=\"w-12 h-12 rounded-xl bg-gradient-to-br from-purple-600 to-purple-700 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" f