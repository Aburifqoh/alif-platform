3.5 py-2 rounded-lg text-sm font-medium transition-colors text-gray-600 dark:text-gray-300 hover:text-brand-red dark:hover:text-brand-red-light hover:bg-[#f0fdf4] dark:hover:bg-brand-red-dark/20\" href=\"/programmes\">Programmes</a></div><div class=\"relative group\"><a class=\"px-3.5 py-2 rounded-lg text-sm font-medium transition-colors text-gray-600 dark:text-gray-300 hover:text-brand-red dark:hover:text-brand-red-light hover:bg-[#f0fdf4] dark:hover:bg-brand-red-dark/20\" href=\"/gallery\">Gallery</a></div><div class=\"relative group\"><a class=\"px-3.5 py-2 rounded-lg text-sm font-medium transition-colors text-gray-600 dark:text-gray-300 hover:text-brand-red dark:hover:text-brand-red-light hover:bg-[#f0fdf4] dark:hover:bg-brand-red-dark/20\" href=\"/events\">News &amp; Events</a></div><div class=\"relative group\"><a class=\"px-3.5 py-2 rounded-lg text-sm font-medium transition-colors text-gray-600 dark:text-gray-300 hover:text-brand-red dark:hover:text-brand-red-light hover:bg-[#f0fdf4] dark:hover:bg-brand-red-dark/20\" href=\"/mosque\">Mosque</a></div><div class=\"relative group\"><a class=\"px-3.5 py-2 rounded-lg text-sm font-medium transition-colors text-gray-600 dark:text-gray-300 hover:text-brand-red dark:hover:text-brand-red-light hover:bg-[#f0fdf4] dark:hover:bg-brand-red-dark/20\" href=\"/contact\">Contact</a></div></nav><div class=\"hidden lg:flex items-center gap-3\"><button aria-label=\"Toggle theme\" class=\"p-2 rounded-lg text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200 hover:bg-gray-100 dark:hover:bg-white/8 transition-colors\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-moon w-4 h-4\" aria-hidden=\"true\"><path d=\"M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401\"></path></svg></button><a class=\"px-4 py-2 text-sm font-medium text-gray-700 dark:text-gray-300 hover:text-brand-red dark:hover:text-brand-red-light transition-colors\" href=\"/login\">Sign in</a><a class=\"px-5 py-2 text-sm font-semibold text-white bg-gradient-to-br from-[#b8860b] to-[#d4a017] rounded-full shadow-md hover:shadow-lg hover:-translate-y-0.5 transition-all font-[Outfit]\" href=\"/donate\">Donate</a><a class=\"px-5 py-2 text-sm font-semibold text-white bg-gradient-to-br from-brand-red to-brand-red-dark rounded-full shadow-md hover:shadow-lg hover:-translate-y-0.5 transition-all font-[Outfit]\" href=\"/register\">Join ALIF</a></div><div class=\"flex lg:hidden items-center gap-2\"><button class=\"p-2 rounded-lg text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-white/8 transition-colors\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-moon w-4 h-4\" aria-hidden=\"true\"><path d=\"M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401\"></path></svg></button><button class=\"p-2 rounded-lg text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-white/8 transition-colors\" aria-label=\"Menu\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-menu w-5 h-5\" aria-hidden=\"true\"><path d=\"M4 5h16\"></path><path d=\"M4 12h16\"></path><path d=\"M4 19h16\"></path></svg></button></div></div></header><main class=\"flex-1\"><div class=\"min-h-screen\"><section class=\"py-20 bg-gradient-to-br from-[#0a3d26] via-[#0f5132] to-[#1e2a35] text-white\"><div class=\"max-w-4xl mx-auto px-4 sm:px-6 text-center\"><span class=\"text-[#d4a017] text-sm font-semibold uppercase tracking-widest\">About Us</span><h1 class=\"mt-3 text-4xl sm:text-5xl md:text-6xl font-bold font-[Outfit] leading-tight\">Al-Ibaanah Islamic Foundation</h1><p class=\"mt-6 text-white/80 text-lg max-w-2xl mx-auto leading-relaxed\">A comprehensive Islamic institution dedicated to propagating authentic Islam and serving the Muslim community through education, Da&#x27;wah, and welfare.</p><div class=\"mt-10 flex flex-wrap justify-center gap-4\"><a class=\"px-8 py-3.5 bg-brand-red hover:bg-brand-red-dark text-white font-semibold rounded-full transition-all font-[Outfit]\" href=\"/programmes\">Explore Our Programmes</a><a class=\"px-8 py-3.5 border border-white/20 hover:bg-white/10 text-white font-medium rounded-full transition-all font-[Outfit]\" href=\"/donate\">Support ALIF</a></div></div></section><section class=\"py-20 bg-white dark:bg-[#0d1117]\"><div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid lg:grid-cols-2 gap-16 items-center\"><div><span class=\"text-brand-red dark:text-brand-red-light text-sm font-semibold uppercase tracking-widest\">Who We Are</span><h2 class=\"mt-3 text-3xl font-bold text-gray-900 dark:text-white font-[Outfit]\">History &amp; Background</h2><div class=\"mt-5 space-y-4 text-gray-600 dark:text-gray-400 leading-relaxed\"><p>Al-Ibaanah Islamic Foundation (ALIF) is a non-governmental, non-political, and non-profit religious organization committed to Islamic da&#x27;wah, education, and community development, guided by authentic Islamic sources.</p><p>Over the years, ALIF has grown into a fully-fledged Islamic institution. We are heavily involved in Qur&#x27;an and Islamic education, rural da&#x27;wah, medical outreach, welfare support, and youth development. We strive to spread the correct understanding of Islam, revive the Sunnah, serve neglected communities, and uplift lives.</p></div><div class=\"mt-10 grid gap-6\"><div class=\"p-6 bg-brand-red-subtle dark:bg-brand-red-dark/10 border-l-4 border-brand-red rounded-r-xl\"><h3 class=\"text-lg font-bold text-brand-red dark:text-brand-red-light font-[Outfit] mb-2\">Our Vision</h3><p class=\"text-gray-700 dark:text-gray-300\">To be a leading and trusted platform for authentic Islamic education, spiritual growth, and comprehensive community development based on the Qur&#x27;an and Sunnah.</p></div><div class=\"p-6 bg-brand-red-subtle dark:bg-brand-red-dark/10 border-l-4 border-brand-red rounded-r-xl\"><h3 class=\"text-lg font-bold text-brand-red dark:text-brand-red-light font-[Outfit] mb-2\">Our Mission</h3><p class=\"text-gray-700 dark:text-gray-300\">To spread the correct understanding of Islam, revive the Sunnah, serve neglected communities, and uplift lives through Islamic guidance and humanitarian care.</p></div></div></div><div class=\"grid grid-cols-2 gap-4\"><div class=\"col-span-2 relative h-64 rounded-2xl overflow-hidden mb-2\"><img src=\"/placeholder-event.jpg\" alt=\"ALIF Community\" class=\"w-full h-full object-cover bg-gray-200 dark:bg-gray-800\"/></div><div class=\"p-6 bg-[#faf6ef] dark:bg-[#161b22] rounded-2xl text-center border border-gray-100 dark:border-white/5\"><div class=\"text-3xl font-bold text-brand-red dark:text-brand-red-light font-[Outfit]\">2010</div><div class=\"text-sm text-gray-500 dark:text-gray-400 mt-1\">Year Established</div></div><div class=\"p-6 bg-[#faf6ef] dark:bg-[#161b22] rounded-2xl text-center border border-gray-100 dark:border-white/5\"><div class=\"text-3xl font-bold text-brand-red dark:text-brand-red-light font-[Outfit]\">2,000+</div><div class=\"text-sm text-gray-500 dark:text-gray-400 mt-1\">Active Members</div></div></div></div></section><section class=\"py-20 bg-[#faf6ef] dark:bg-[#161b22]\"><div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\"><div class=\"text-center mb-16\"><span class=\"text-brand-red dark:text-brand-red-light text-sm font-semibold uppercase tracking-widest\">Our Focus</span><h2 class=\"mt-3 text-3xl font-bold text-gray-900 dark:text-white font-[Outfit]\">Aims &amp; Objectives</h2><p class=\"mt-4 text-gray-600 dark:text-gray-400 max-w-2xl mx-auto\">The foundational goals that drive all activities at Al-Ibaanah Islamic Foundation.</p></div><div class=\"grid md:grid-cols-2 lg:grid-cols-3 gap-6\"><div class=\"bg-white dark:bg-[#0d1117] p-8 rounded-2xl border border-gray-100 dark:border-white/5 hover:border-brand-red/30 transition-all group\"><div class=\"w-12 h-12 rounded-xl bg-brand-red-subtle dark:bg-brand-red-dark/30 text-brand-red flex items-center justify-center mb-6 group-hover:scale-110 transition-transform\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-heart-handshake w-6 h-6\" aria-hidden=\"true\"><path d=\"M19.414 14.414C21 12.828 22 11.5 22 9.5a5.5 5.5 0 0 0-9.591-3.676.6.6 0 0 1-.818.001A5.5 5.5 0 0 0 2 9.5c0 2.3 1.5 4 3 5.5l5.535 5.362a2 2 0 0 0 2.879.052 2.12 2.12 0 0 0-.004-3 2.124 2.124 0 1 0 3-3 2.124 2.124 0 0 0 3.004 0 2 2 0 0 0 0-2.828l-1.881-1.882a2.41 2.41 0 0 0-3.409 0l-1.71 1.71a2 2 0 0 1-2.828 0 2 2 0 0 1 0-2.828l2.823-2.762\"></path></svg></div><h3 class=\"text-xl font-bold text-gray-900 dark:text-white font-[Outfit] mb-3\">Promotion of Islamic Values</h3><p class=\"text-gray-600 dark:text-gray-400 leading-relaxed\">Teaching the Qur’an, Hadith, and Sunnah with adherence to Salafi methodology, and fostering moral reformation.</p></div><div class=\"bg-white dark:bg-[#0d1117] p-8 rounded-2xl border border-gray-100 dark:border-white/5 hover:border-brand-red/30 transition-all group\"><div class=\"w-12 h-12 rounded-xl bg-brand-red-subtle dark:bg-brand-red-dark/30 text-brand-red flex items-center justify-center mb-6 group-hover:scale-110 transition-transform\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-hand-heart w-6 h-6\" aria-hidden=\"true\"><path d=\"M11 14h2a2 2 0 0 0 0-4h-3c-.6 0-1.1.2-1.4.6L3 16\"></path><path d=\"m14.45 13.39 5.05-4.694C20.196 8 21 6.85 21 5.75a2.75 2.75 0 0 0-4.797-1.837.276.276 0 0 1-.406 0A2.75 2.75 0 0 0 11 5.75c0 1.2.802 2.248 1.5 2.946L16 11.95\"></path><path d=\"m2 15 6 6\"></path><path d=\"m7 20 1.6-1.4c.3-.4.8-.6 1.4-.6h4c1.1 0 2.1-.4 2.8-1.2l4.6-4.4a1 1 0 0 0-2.75-2.91\"></path></svg></div><h3 class=\"text-xl font-bold text-gray-900 dark:text-white font-[Outfit] mb-3\">Support for Vulnerable Populations</h3><p class=\"text-gray-600 dark:text-gray-400 leading-relaxed\">Supporting orphans, widows, the poor, and other vulnerable groups through sustained social welfare programs.</p></div><div class=\"bg-white dark:bg-[#0d1117] p-8 rounded-2xl border border-gray-100 dark:border-white/5 hover:border-brand-red/30 transition-all group\"><div class=\"w-12 h-12 rounded-xl bg-brand-red-subtle dark:bg-brand-red-dark/30 text-brand-red flex items-center justify-center mb-6 group-hover:scale-110 transition-transform\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-graduation-cap w-6 h-6\" aria-hidden=\"true\"><path d=\"M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z\"></path><path d=\"M22 10v6\"></path><path d=\"M6 12.5V16a6 3 0 0 0 12 0v-3.5\"></path></svg></div><h3 class=\"text-xl font-bold text-gray-900 dark:text-white font-[Outfit] mb-3\">Educational Development</h3><p class=\"text-gray-600 dark:text-gray-400 leading-relaxed\">Organizing Arabic-medium Qur’an and Islamic studies classes both physically and online for comprehensive learning.</p></div><div class=\"bg-white dark:bg-[#0d1117] p-8 rounded-2xl border border-gray-100 dark:border-white/5 hover:border-brand-red/30 transition-all group\"><div class=\"w-12 h-12 rounded-xl bg-brand-red-subtle dark:bg-brand-red-dark/30 text-brand-red flex items-center justify-center mb-6 group-hover:scale-110 transition-transform\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-building2 lucide-building-2 w-6 h-6\" aria-hidden=\"true\"><path d=\"M10 12h4\"></path><path d=\"M10 8h4\"></path><path d=\"M14 21v-3a2 2 0 0 0-4 0v3\"></path><path d=\"M6 10H4a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-2\"></path><path d=\"M6 21V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v16\"></path></svg></div><h3 class=\"text-xl font-bold text-gray-900 dark:text-white font-[Outfit] mb-3\">Community Development</h3><p class=\"text-gray-600 dark:text-gray-400 leading-relaxed\">Promoting peaceful coexistence, organizing community services, public lectures, khutbahs, and outreach programs.</p></div><div class=\"bg-white dark:bg-[#0d1117] p-8 rounded-2xl border border-gray-100 dark:border-white/5 hover:border-brand-red/30 transition-all group\"><div class=\"w-12 h-12 rounded-xl bg-brand-red-subtle dark:bg-brand-red-dark/30 text-brand-red flex items-center justify-center mb-6 group-hover:scale-110 transition-transform\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-globe w-6 h-6\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20\"></path><path d=\"M2 12h20\"></path></svg></div><h3 class=\"text-xl font-bold text-gray-900 dark:text-white font-[Outfit] mb-3\">Partnerships and Growth</h3><p class=\"text-gray-600 dark:text-gray-400 leading-relaxed\">Collaborating with lawful Islamic and humanitarian organizations for community upliftment and poverty reduction.</p></div></div></div></section><section class=\"py-20 bg-white dark:bg-[#0d1117]\"><div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\"><div class=\"text-center mb-16\"><span class=\"text-brand-red dark:text-brand-red-light text-sm font-semibold uppercase tracking-widest\">What We Do</span><h2 class=\"mt-3 text-3xl font-bold text-gray-900 dark:text-white font-[Outfit]\">Foundation Activities</h2><p class=\"mt-4 text-gray-600 dark:text-gray-400 max-w-2xl mx-auto\">Our ongoing programmes and initiatives designed to educate, support, and uplift the Muslim community.</p></div><div class=\"grid sm:grid-cols-2 lg:grid-cols-4 gap-4\"><div class=\"p-5 bg-gray-50 dark:bg-[#161b22] rounded-xl border border-gray-100 dark:border-white/5\"><div class=\"flex items-center gap-3 mb-3\"><div class=\"w-8 h-8 rounded-lg bg-brand-red-subtle dark:bg-brand-red-dark/20 text-brand-red flex items-center justify-center shrink-0\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-mic w-4 h-4\" aria-hidden=\"true\"><path d=\"M12 19v3\"></path><path d=\"M19 10v2a7 7 0 0 1-14 0v-2\"></path><rect x=\"9\" y=\"2\" width=\"6\" height=\"13\" rx=\"3\"></rect></svg></div><h3 class=\"font-bold text-gray-900 dark:text-white font-[Outfit] leading-tight\">Da&#x27;wah Enlightenment</h3></div><p class=\"text-sm text-gray-600 dark:text-gray-400\">Spreading the correct understanding of Islam through continuous lectures and talks.</p></div><div class=\"p-5 bg-gray-50 dark:bg-[#161b22] rounded-xl border border-gray-100 dark:border-white/5\"><div class=\"flex items-center gap-3 mb-3\"><div class=\"w-8 h-8 rounded-lg bg-brand-red-subtle dark:bg-brand-red-dark/20 text-brand-red flex items-center justify-center shrink-0\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-users w-4 h-4\" aria-hidden=\"true\"><path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"></path><path d=\"M16 3.128a4 4 0 0 1 0 7.744\"></path><path d=\"M22 21v-2a4 4 0 0 0-3-3.87\"></path><circle cx=\"9\" cy=\"7\" r=\"4\"></circle></svg></div><h3 class=\"font-bold text-gray-900 dark:text-white font-[Outfit] leading-tight\">General Meeting</h3></div><p class=\"text-sm text-gray-600 dark:text-gray-400\">Regular gatherings to foster unity, plan activities, and strengthen community bonds.</p></div><div class=\"p-5 bg-gray-50 dark:bg-[#161b22] rounded-xl border border-gray-100 dark:border-white/5\"><div class=\"flex items-center gap-3 mb-3\"><div class=\"w-8 h-8 rounded-lg bg-brand-red-subtle dark:bg-brand-red-dark/20 text-brand-red flex items-center justify-center shrink-0\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-book w-4 h-4\" aria-hidden=\"true\"><path d=\"M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H19a1 1 0 0 1 1 1v18a1 1 0 0 1-1 1H6.5a1 1 0 0 1 0-5H20\"></path></svg></div><h3 class=\"font-bold text-gray-900 dark:text-white font-[Outfit] leading-tight\">Sisters&#x27; Circle</h3></div><p class=\"text-sm text-gray-600 dark:text-gray-400\">Dedicated educational and spiritual programs specifically designed for Muslim sisters.</p></div><div class=\"p-5 bg-gray-50 dark:bg-[#161b22] rounded-xl border border-gray-100 dark:border-white/5\"><div class=\"flex items-center gap-3 mb-3\"><div class=\"w-8 h-8 rounded-lg bg-brand-red-subtle dark:bg-brand-red-dark/20 text-brand-red flex items-center justify-center shrink-0\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-map-pin w-4 h-4\" aria-hidden=\"true\"><path d=\"M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0\"></path><circle cx=\"12\" cy=\"10\" r=\"3\"></circle></svg></div><h3 class=\"font-bold text-gray-900 dark:text-white font-[Outfit] leading-tight\">Orientation Week</h3></div><p class=\"text-sm text-gray-600 dark:text-gray-400\">Welcoming and guiding freshers and new members into the ALIF community.</p></div><div class=\"p-5 bg-gray-50 dark:bg-[#161b22] rounded-xl border border-gray-100 dark:border-white/5\"><div class=\"flex items-center gap-3 mb-3\"><div class=\"w-8 h-8 rounded-lg bg-brand-red-subtle dark:bg-brand-red-dark/20 text-brand-red flex items-center justify-center shrink-0\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-book-open w-4 h-4\" aria-hidden=\"true\"><path d=\"M12 5v16\"></path><path d=\"M20.001 19A2 2 0 0022 17V5a2 2 0 00-1.999-2L16 3.002A5 5 0 0012 5a5 5 0 00-4-2H4a2 2 0 00-2 2v12a2 2 0 001.999 2H8a5 5 0 014 2 5 5 0 014-2z\"></path></svg></div><h3 class=\"font-bold text-gray-900 dark:text-white font-[Outfit] leading-tight\">Madrasah</h3></div><p class=\"text-sm text-gray-600 dark:text-gray-400\">Structured Islamic education focusing on Arabic, Aqeedah, Fiqh, and more.</p></div><div class=\"p-5 bg-gray-50 dark:bg-[#161b22] rounded-xl border border-gray-100 dark:border-white/5\"><div class=\"flex items-center gap-3 mb-3\"><div class=\"w-8 h-8 rounded-lg bg-brand-red-subtle dark:bg-brand-red-dark/20 text-brand-red flex items-center justify-center shrink-0\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-calendar w-4 h-4\" aria-hidden=\"true\"><path d=\"M8 2v3\"></path><path d=\"M16 2v3\"></path><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\"></rect><path d=\"M3 9h18\"></path></svg></div><h3 class=\"font-bold text-gray-900 dark:text-white font-[Outfit] leading-tight\">Ramadan Programmes</h3></div><p class=\"text-sm text-gray-600 dark:text-gray-400\">Tafseer, Iftar gatherings, Qiyam, and special spiritual activities during the blessed month.</p></div><div class=\"p-5 bg-gray-50 dark:bg-[#161b22] rounded-xl border border-gray-100 dark:border-white/5\"><div class=\"flex items-center gap-3 mb-3\"><div class=\"w-8 h-8 rounded-lg bg-brand-red-subtle dark:bg-brand-red-dark/20 text-brand-red flex items-center justify-center shrink-0\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-mic w-4 h-4\" aria-hidden=\"true\"><path d=\"M12 19v3\"></path><path d=\"M19 10v2a7 7 0 0 1-14 0v-2\"></path><rect x=\"9\" y=\"2\" width=\"6\" height=\"13\" rx=\"3\"></rect></svg></div><h3 class=\"font-bold text-gray-900 dark:text-white font-[Outfit] leading-tight\">Public Lectures</h3></div><p class=\"text-sm text-gray-600 dark:text-gray-400\">Open lectures featuring scholars to educate the general public on vital Islamic topics.</p></div><div class=\"p-5 bg-gray-50 dark:bg-[#161b22] rounded-xl border border-gray-100 dark:border-white/5\"><div class=\"flex items-center gap-3 mb-3\"><div class=\"w-8 h-8 rounded-lg bg-brand-red-subtle dark:bg-brand-red-dark/20 text-brand-red flex items-center justify-center shrink-0\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-globe w-4 h-4\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20\"></path><path d=\"M2 12h20\"></path></svg></div><h3 class=\"font-bold text-gray-900 dark:text-white font-[Outfit] leading-tight\">Rural Da&#x27;wah</h3></div><p class=\"text-sm text-gray-600 dark:text-gray-400\">Village outreach programs aimed at teaching Islam and supporting remote communities.</p></div><div class=\"p-5 bg-gray-50 dark:bg-[#161b22] rounded-xl border border-gray-100 dark:border-white/5\"><div class=\"flex items-center gap-3 mb-3\"><div class=\"w-8 h-8 rounded-lg bg-brand-red-subtle dark:bg-brand-red-dark/20 text-brand-red flex items-center justify-center shrink-0\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-book w-4 h-4\" aria-hidden=\"true\"><path d=\"M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H19a1 1 0 0 1 1 1v18a1 1 0 0 1-1 1H6.5a1 1 0 0 1 0-5H20\"></path></svg></div><h3 class=\"font-bold text-gray-900 dark:text-white font-[Outfit] leading-tight\">Halqoh</h3></div><p class=\"text-sm text-gray-600 dark:text-gray-400\">Intensive study circles for deep and focused learning of classical Islamic texts.</p></div><div class=\"p-5 bg-gray-50 dark:bg-[#161b22] rounded-xl border border-gray-100 dark:border-white/5\"><div class=\"flex items-center gap-3 mb-3\"><div class=\"w-8 h-8 rounded-lg bg-brand-red-subtle dark:bg-brand-red-dark/20 text-brand-red flex items-center justify-center shrink-0\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-graduation-cap w-4 h-4\" aria-hidden=\"true\"><path d=\"M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z\"></path><path d=\"M22 10v6\"></path><path d=\"M6 12.5V16a6 3 0 0 0 12 0v-3.5\"></path></svg></div><h3 class=\"font-bold text-gray-900 dark:text-white font-[Outfit] leading-tight\">Tutorial Classes</h3></div><p class=\"text-sm text-gray-600 dark:text-gray-400\">Academic support and tutorial classes for students in secular and Islamic studies.</p></div><div class=\"p-5 bg-gray-50 dark:bg-[#161b22] rounded-xl border border-gray-100 dark:border-white/5\"><div class=\"flex items-center gap-3 mb-3\"><div class=\"w-8 h-8 rounded-lg bg-brand-red-subtle dark:bg-brand-red-dark/20 text-brand-red flex items-center justify-center shrink-0\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-award w-4 h-4\" aria-hidden=\"true\"><path d=\"m15.477 12.89 1.515 8.526a.5.5 0 0 1-.81.47l-3.58-2.687a1 1 0 0 0-1.197 0l-3.586 2.686a.5.5 0 0 1-.81-.469l1.514-8.526\"></path><circle cx=\"12\" cy=\"8\" r=\"6\"></circle></svg></div><h3 class=\"font-bold text-gray-900 dark:text-white font-[Outfit] leading-tight\">Qur&#x27;an Competition</h3></div><p class=\"text-sm text-gray-600 dark:text-gray-400\">Annual quiz and Qur&#x27;an memorization competitions to encourage Hifdh and study.</p></div><div class=\"p-5 bg-gray-50 dark:bg-[#161b22] rounded-xl border border-gray-100 dark:border-white/5\"><div class=\"flex items-center gap-3 mb-3\"><div class=\"w-8 h-8 rounded-lg bg-brand-red-subtle dark:bg-brand-red-dark/20 text-brand-red flex items-center justify-center shrink-0\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-target w-4 h-4\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><circle cx=\"12\" cy=\"12\" r=\"6\"></circle><circle cx=\"12\" cy=\"12\" r=\"2\"></circle></svg></div><h3 class=\"font-bold text-gray-900 dark:text-white font-[Outfit] leading-tight\">Sec. Sch Da&#x27;wah</h3></div><p class=\"text-sm text-gray-600 dark:text-gray-400\">Outreach programs designed specifically for secondary school students to build early foundations.</p></div></div><div class=\"mt-12 text-center\"><a class=\"inline-flex items-center gap-2 px-6 py-3 border border-gray-200 dark:border-white/10 text-gray-700 dark:text-gray-300 font-medium rounded-full hover:bg-gray-50 dark:hover:bg-white/5 transition-all\" href=\"/programmes\">View All Programmes →</a></div></div></section><section class=\"py-20 bg-gradient-to-br from-[#0a3d26] to-[#0f5132] text-white\"><div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\"><div class=\"text-center mb-12\"><h2 class=\"text-3xl font-bold font-[Outfit]\">Our Impact</h2><p class=\"mt-4 text-white/70 max-w-2xl mx-auto\">By the grace of Allah, ALIF continues to reach communities and touch lives through our various programs.</p></div><div class=\"grid grid-cols-2 md:grid-cols-4 gap-8 divide-x divide-white/10 border-t border-white/10 pt-12\"><div class=\"text-center px-4\"><div class=\"text-4xl sm:text-5xl font-bold font-[Outfit] text-[#d4a017] mb-2\">—</div><div class=\"text-sm font-medium uppercase tracking-wider text-white/80\">Communities Reached</div></div><div class=\"text-center px-4\"><div class=\"text-4xl sm:text-5xl font-bold font-[Outfit] text-[#d4a017] mb-2\">—</div><div class=\"text-sm font-medium uppercase tracking-wider text-white/80\">Programmes Conducted</div></div><div class=\"text-center px-4\"><div class=\"text-4xl sm:text-5xl font-bold font-[Outfit] text-[#d4a017] mb-2\">—</div><div class=\"text-sm font-medium uppercase tracking-wider text-white/80\">Students Taught</div></div><div class=\"text-center px-4\"><div class=\"text-4xl sm:text-5xl font-bold font-[Outfit] text-[#d4a017] mb-2\">—</div><div class=\"text-sm font-medium uppercase tracking-wider text-white/80\">People Served</div></div></div></div></section><section class=\"py-20 bg-[#faf6ef] dark:bg-[#161b22]\"><div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\"><div class=\"text-center mb-16\"><span class=\"text-brand-red dark:text-brand-red-light text-sm font-semibold uppercase tracking-widest\">Leadership</span><h2 class=\"mt-3 text-3xl font-bold text-gray-900 dark:text-white font-[Outfit]\">Governance Structure</h2><p class=\"mt-4 text-gray-600 dark:text-gray-400 max-w-2xl mx-auto\">Our organization is structured to ensure accountability, transparency, and adherence to Islamic principles.</p></div><div class=\"grid md:grid-cols-3 gap-8\"><div class=\"bg-white dark:bg-[#0d1117] p-8 rounded-2xl border border-gray-100 dark:border-white/5\"><h3 class=\"text-xl font-bold text-brand-red dark:text-brand-red-light font-[Outfit] mb-4\">Board of Trustees</h3><p class=\"text-sm text-gray-600 dark:text-gray-400 mb-6\">Provides legal oversight, strategic direction, and approval of major organizational decisions.</p><ul class=\"space-y-3\"><li class=\"flex items-center gap-3\"><div class=\"w-2 h-2 rounded-full bg-brand-red\"></div><span class=\"font-medium text-gray-900 dark:text-white\">Mustapha Luqman Gbolahan</span><span class=\"text-xs text-gray-500\">(Chairman)</span></li><li class=\"flex items-center gap-3\"><div class=\"w-2 h-2 rounded-full bg-brand-red\"></div><span class=\"font-medium text-gray-900 dark:text-white\">Adeniji Lukman</span><span class=\"text-xs text-gray-500\">(Secretary)</span></li></ul></div><div class=\"bg-white dark:bg-[#0d1117] p-8 rounded-2xl border border-gray-100 dark:border-white/5\"><h3 class=\"text-xl font-bold text-brand-red dark:text-brand-red-light font-[Outfit] mb-4\">Executive Council</h3><p class=\"text-sm text-gray-600 dark:text-gray-400 mb-6\">Responsible for policy execution, day-to-day management, program coordination, and financial oversight.</p><ul class=\"space-y-2 text-sm text-gray-700 dark:text-gray-300\"><li class=\"flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check-big w-4 h-4 text-brand-red\" aria-hidden=\"true\"><path d=\"M21.801 10A10 10 0 1 1 17 3.335\"></path><path d=\"m9 11 3 3L22 4\"></path></svg> Director-General</li><li class=\"flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check-big w-4 h-4 text-brand-red\" aria-hidden=\"true\"><path d=\"M21.801 10A10 10 0 1 1 17 3.335\"></path><path d=\"m9 11 3 3L22 4\"></path></svg> Secretary-General</li><li class=\"flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check-big w-4 h-4 text-brand-red\" aria-hidden=\"true\"><path d=\"M21.801 10A10 10 0 1 1 17 3.335\"></path><path d=\"m9 11 3 3L22 4\"></path></svg> Financial Secretary</li><li class=\"flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check-big w-4 h-4 text-brand-red\" aria-hidden=\"true\"><path d=\"M21.801 10A10 10 0 1 1 17 3.335\"></path><path d=\"m9 11 3 3L22 4\"></path></svg> Da’wah &amp; Education Coordinators</li></ul></div><div class=\"bg-white dark:bg-[#0d1117] p-8 rounded-2xl border border-gray-100 dark:border-white/5\"><h3 class=\"text-xl font-bold text-brand-red dark:text-brand-red-light font-[Outfit] mb-4\">Advisory Council</h3><p class=\"text-sm text-gray-600 dark:text-gray-400 mb-6\">Comprised of senior scholars and elders providing Shari’ah guidance and conflict resolution.</p><ul class=\"space-y-3\"><li class=\"flex items-center gap-3\"><div class=\"w-2 h-2 rounded-full bg-brand-red\"></div><span class=\"font-medium text-gray-900 dark:text-white\">Sheikh Dr. Sharaf Gbadebo Raaji</span></li><li class=\"flex items-center gap-3\"><div class=\"w-2 h-2 rounded-full bg-brand-red\"></div><span class=\"font-medium text-gray-900 dark:text-white\">Sheikh Abdulgaffaar Oniwiridi</span></li></ul></div></div></div></section><section class=\"py-20 bg-white dark:bg-[#0d1117]\"><div class=\"max-w-4xl mx-auto px-4 sm:px-6 lg:px-8\"><div class=\"bg-[#faf6ef] dark:bg-[#161b22] rounded-3xl p-8 md:p-12 border border-gray-100 dark:border-white/5 text-center\"><h2 class=\"text-3xl font-bold text-gray-900 dark:text-white font-[Outfit] mb-6\">Official Information</h2><div class=\"grid sm:grid-cols-3 gap-6 mb-10 text-left\"><div class=\"flex flex-col items-center text-center p-4\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-award w-8 h-8 text-brand-red mb-3\" aria-hidden=\"true\"><path d=\"m15.477 12.89 1.515 8.526a.5.5 0 0 1-.81.47l-3.58-2.687a1 1 0 0 0-1.197 0l-3.586 2.686a.5.5 0 0 1-.81-.469l1.514-8.526\"></path><circle cx=\"12\" cy=\"8\" r=\"6\"></circle></svg><h4 class=\"font-bold text-gray-900 dark:text-white mb-1\">Registration</h4><p class=\"text-sm text-gray-600 dark:text-gray-400\">CAC RC Number:<br/>7913296</p></div><div class=\"flex flex-col items-center text-center p-4\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-map-pin w-8 h-8 text-brand-red mb-3\" aria-hidden=\"true\"><path d=\"M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0\"></path><circle cx=\"12\" cy=\"10\" r=\"3\"></circle></svg><h4 class=\"font-bold text-gray-900 dark:text-white mb-1\">Headquarters</h4><p class=\"text-sm text-gray-600 dark:text-gray-400\">No. 12, Orisunbare St, Off Egbejila Rd, Asa Dam, Ilorin, Kwara State</p></div><div class=\"flex flex-col items-center text-center p-4\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-phone w-8 h-8 text-brand-red mb-3\" aria-hidden=\"true\"><path d=\"M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384\"></path></svg><h4 class=\"font-bold text-gray-900 dark:text-white mb-1\">Contact</h4><p class=\"text-sm text-gray-600 dark:text-gray-400\">08100015106<br/>ibaanah.fdn@gmail.com</p></div></div><div class=\"border-t border-gray-200 dark:border-white/10 pt-10\"><h3 class=\"text-2xl font-bold text-gray-900 dark:text-white font-[Outfit] mb-4\">Support Our Mission</h3><p class=\"text-gray-600 dark:text-gray-400 mb-8 max-w-2xl mx-auto\">Join our growing community and contribute to the mission of authentic Islamic propagation, humanitarian care, and educational excellence.</p><div class=\"flex flex-wrap justify-center gap-4\"><a class=\"px-8 py-3.5 bg-gradient-to-r from-brand-red to-brand-red-dark text-white font-semibold rounded-full hover:shadow-lg transition-all font-[Outfit]\" href=\"/donate\">Support ALIF</a><a class=\"px-8 py-3.5 border border-gray-200 dark:border-white/10 text-gray-700 dark:text-gray-300 font-medium rounded-full hover:bg-gray-50 dark:hover:bg-white/5 transition-all\" href=\"/contact\">Contact Us</a></div></div></div></div></section></div><!--$--><!--/$--></main><footer class=\"bg-[#0a3d26] 