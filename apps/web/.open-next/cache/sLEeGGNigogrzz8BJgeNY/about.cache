{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/about/layout,_N_T_/about/page,_N_T_/about"},"segmentPaths":["/_tree","/_full","/about/__PAGE__","/about","/_index","/_head"]},"html":"<!DOCTYPE html><html lang=\"en\" class=\"h-full antialiased scroll-smooth font-sans\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" href=\"/placeholder-event.jpg\" as=\"image\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/21bhamjvonk46.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/1jaqcb5t0gyu5.js\"/><script src=\"/_next/static/chunks/0ygc4gdmkgzp5.js\" async=\"\"></script><script src=\"/_next/static/chunks/05d0664tma5ib.js\" async=\"\"></script><script src=\"/_next/static/chunks/0i-xku-e8fc-q.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-2ubugnzvw5yr6.js\" async=\"\"></script><script src=\"/_next/static/chunks/15gec113tm441.js\" async=\"\"></script><script src=\"/_next/static/chunks/2myco9ookedv3.js\" async=\"\"></script><script src=\"/_next/static/chunks/1eplogyd5x6l-.js\" async=\"\"></script><script src=\"/_next/static/chunks/08i3qwm_r6g6n.js\" async=\"\"></script><link rel=\"preload\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&amp;family=Amiri:wght@400;700&amp;family=Inter:wght@100..900&amp;family=Outfit:wght@100..900&amp;display=swap\" as=\"style\"/><link rel=\"preconnect\" href=\"https://fonts.googleapis.com\"/><link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin=\"anonymous\"/><meta name=\"theme-color\" content=\"#0f5132\" media=\"(prefers-color-scheme: light)\"/><meta name=\"theme-color\" content=\"#0d1117\" media=\"(prefers-color-scheme: dark)\"/><title>About Al-Ibaanah Islamic Foundation | ALIF | ALIF</title><meta name=\"description\" content=\"Learn about Al-Ibaanah Islamic Foundation — our mission, vision, history, and leadership.\"/><link rel=\"author\" href=\"http://localhost:3000\"/><meta name=\"author\" content=\"Al-Ibaanah Islamic Foundation\"/><meta name=\"keywords\" content=\"Al-Ibaanah Islamic Foundation,ALIF,Islamic Foundation Nigeria,Da&#x27;wah,Islamic education,Qur&#x27;an learning,Tajweed,Arabic language,Salafi dawah,Islamic hostel,Islamic community,Ahlus Sunnah\"/><meta name=\"creator\" content=\"Al-Ibaanah Islamic Foundation\"/><meta name=\"publisher\" content=\"Al-Ibaanah Islamic Foundation\"/><meta name=\"robots\" content=\"index, follow\"/><meta name=\"googlebot\" content=\"index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1\"/><meta name=\"category\" content=\"Religion\"/><link rel=\"canonical\" href=\"http://localhost:3000\"/><meta name=\"format-detection\" content=\"telephone=no\"/><meta property=\"og:title\" content=\"Al-Ibaanah Islamic Foundation (ALIF)\"/><meta property=\"og:description\" content=\"Propagating authentic Islam through education, Da&#x27;wah, and community development.\"/><meta property=\"og:url\" content=\"http://localhost:3000\"/><meta property=\"og:site_name\" content=\"Al-Ibaanah Islamic Foundation\"/><meta property=\"og:locale\" content=\"en_NG\"/><meta property=\"og:image\" content=\"http://localhost:3000/assets/alif-og.png\"/><meta property=\"og:image:width\" content=\"1200\"/><meta property=\"og:image:height\" content=\"630\"/><meta property=\"og:image:alt\" content=\"Al-Ibaanah Islamic Foundation\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"Al-Ibaanah Islamic Foundation (ALIF)\"/><meta name=\"twitter:description\" content=\"Propagating authentic Islam through education, Da&#x27;wah &amp; community development.\"/><meta name=\"twitter:image\" content=\"http://localhost:3000/assets/alif-og.png\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.2vob68tjqpejf.ico\" sizes=\